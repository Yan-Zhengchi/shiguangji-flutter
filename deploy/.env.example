# ============ 食光记部署环境变量模板 ============
# 首次部署：cp .env.example .env 后修改各项取值

# Docker Hub 镜像地址（改为你的实际地址）
DOCKER_IMAGE=starkwu/shiguangji-server:1.0.0

# 服务器上 Docker 数据卷根目录（按实际服务器改）
# 群晖 NAS 一般为 /volume1/docker/shiguangji
# 本地相对路径（./data）则落在 deploy/ 目录下
DATA_DIR=/volume1/docker/shiguangji

# 对外端口（app 服务）
APP_PORT=8080

# MySQL（生成随机密码：openssl rand -hex 16，只含字母数字，避免 healthcheck shell 转义问题）
MYSQL_USER=shiguangji
MYSQL_PASSWORD=ChangeMe_Mysql_Pwd

# Redis
REDIS_PASSWORD=ChangeMe_Redis_Pwd

# JWT 密钥（至少 256 位，生成：openssl rand -base64 48）
JWT_SECRET=ChangeMe_Jwt_Secret_At_Least_32_Bytes_Long
